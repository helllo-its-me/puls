{
  "name": "@health/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "drizzle-kit check && tsx scripts/check-schema-migrations.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
