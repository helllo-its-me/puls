{
  "name": "health-app-monorepo",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": "22.19.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @health/api --filter @health/mobile dev",
    "dev:full": "node ./scripts/dev-full.mjs",
    "dev:down": "node ./scripts/dev-down.mjs",
    "dev:mobile": "pnpm --filter @health/mobile dev",
    "dev:api": "pnpm --filter @health/api dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @health/db db:generate",
    "db:migrate": "pnpm --filter @health/db db:migrate",
    "db:check": "pnpm --filter @health/db db:check",
    "db:seed": "pnpm --filter @health/db db:seed",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm db:check && pnpm test:unit && pnpm test:migrations && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:migrations": "tsc --noEmit -p tsconfig.migrations.json && vitest run --config vitest.migrations.config.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.59.1",
    "@types/node": "~22.19.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.5"
  }
}
