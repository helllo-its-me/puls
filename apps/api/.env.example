NODE_ENV=development
AUTH_TOKEN_SECRET=replace-with-a-local-development-secret
AUTH_TOKEN_PREVIOUS_SECRETS=
AUTH_TRUST_PROXY_HOPS=0
WEB_APP_ORIGINS=http://localhost:8081
REGISTRATION_MIN_RESPONSE_MS=1000
PASSWORD_RESET_MIN_RESPONSE_MS=1000
PASSWORD_RESET_EMAIL_DELIVERY_MODE=log
PASSWORD_RESET_SMTP_HOST=smtp.example.com
PASSWORD_RESET_SMTP_PORT=465
PASSWORD_RESET_SMTP_SECURE=true
PASSWORD_RESET_SMTP_USER=
PASSWORD_RESET_SMTP_PASSWORD=
PASSWORD_RESET_EMAIL_FROM=Puls <no-reply@example.com>
PORT=3001
