    "hono": "^4.12.27",
    "nodemailer": "^9.0.3",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "~22.19.0",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.27.4",
